# Content Moderation Engine - Environment Configuration
APP_NAME=Real-Time Content Moderation Engine
APP_VERSION=1.0.0
APP_ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Model & Inference Settings
MODEL_NAME=distilbert-base-uncased
MODEL_ONNX_PATH=models/onnx/model.onnx
MODEL_PYTORCH_PATH=models/pytorch
MAX_SEQUENCE_LENGTH=128
INFERENCE_ENGINE=onnx
EXECUTION_PROVIDER=CPUExecutionProvider
NUM_THREADS=4

# Policy & Thresholds
DEFAULT_TOXICITY_THRESHOLD=0.50
STRICT_TOXICITY_THRESHOLD=0.35
FLAG_REVIEW_THRESHOLD=0.40

# Batching & Concurrency
BATCH_MAX_SIZE=64
BATCH_TIMEOUT_MS=5
MAX_CONCURRENT_REQUESTS=100
MAX_PAYLOAD_CHARS=10000

# Security
API_KEY=
REQUIRE_API_KEY=false
